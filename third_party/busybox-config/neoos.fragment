# NeoOS BusyBox configuration fragment.
#
# Applied over `make allnoconfig` by apply.sh, then resolved with
# `make olddefconfig`. A fragment rather than a whole .config so that a
# BusyBox version bump does not silently drop new options -- olddefconfig
# picks the upstream default for anything not named here.
#
# defconfig does not work: it enables console-tools (openvt, kbd_mode,
# loadfont), which include <linux/vt.h> and <linux/kd.h>. Those are Linux
# KERNEL headers, not libc ones, and musl deliberately does not ship
# them. NeoOS has its own VT interface; those applets are not wanted.
#
# The goal is an interactive `ash` with the tools a shell session needs
# -- not a complete BusyBox.

# ---- build ----------------------------------------------------------
CONFIG_STATIC=y
CONFIG_STATIC_LIBGCC=y
CONFIG_CROSS_COMPILER_PREFIX="x86_64-elf-"
CONFIG_NOMMU=n
CONFIG_LFS=y

# One binary, applets dispatched internally: FAT16 has no symlinks, so
# the usual /bin/ls -> busybox layout is not available to us.
CONFIG_BUSYBOX=y
CONFIG_FEATURE_SH_STANDALONE=y
CONFIG_FEATURE_PREFER_APPLETS=y
CONFIG_BUSYBOX_EXEC_PATH="/BIN/BUSYBOX.ELF"
CONFIG_FEATURE_SUID=n
CONFIG_SELINUX=n
CONFIG_PAM=n
CONFIG_FEATURE_UTMP=n
CONFIG_FEATURE_WTMP=n
CONFIG_FEATURE_SYSLOG=n
CONFIG_LOCALE_SUPPORT=n
CONFIG_UNICODE_SUPPORT=n
CONFIG_LONG_OPTS=y
CONFIG_SHOW_USAGE=y
CONFIG_FEATURE_VERBOSE_USAGE=n

# ---- the shell ------------------------------------------------------
CONFIG_SH_IS_ASH=y
CONFIG_ASH=y
CONFIG_ASH_INTERNAL_GLOB=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_ASH_ALIAS=y
CONFIG_ASH_GETOPTS=y
CONFIG_ASH_BUILTIN_ECHO=y
CONFIG_ASH_BUILTIN_PRINTF=y
CONFIG_ASH_BUILTIN_TEST=y
CONFIG_ASH_CMDCMD=y
CONFIG_ASH_OPTIMIZE_FOR_SIZE=y
CONFIG_ASH_EXPAND_PRMT=y
CONFIG_ASH_RANDOM_SUPPORT=n
CONFIG_ASH_IDLE_TIMEOUT=n
CONFIG_ASH_BASH_COMPAT=y
# $((...)). A shell without arithmetic is a poor shell, and its absence
# is how bbsh first proved the shell was really executing commands: it
# answered "support for $((arith)) is disabled", which is a response.
CONFIG_FEATURE_SH_MATH=y
CONFIG_FEATURE_SH_MATH_64=y
CONFIG_FEATURE_EDITING=y
CONFIG_FEATURE_EDITING_MAX_LEN=1024
CONFIG_FEATURE_EDITING_HISTORY=64
CONFIG_FEATURE_TAB_COMPLETION=y
CONFIG_FEATURE_EDITING_VI=n
CONFIG_FEATURE_EDITING_FANCY_PROMPT=y

# ---- coreutils a session actually uses ------------------------------
CONFIG_CAT=y
CONFIG_ECHO=y
CONFIG_PWD=y
CONFIG_LS=y
CONFIG_FEATURE_LS_FILETYPES=y
CONFIG_FEATURE_LS_FOLLOWLINKS=y
CONFIG_FEATURE_LS_RECURSIVE=y
CONFIG_FEATURE_LS_WIDTH=y
CONFIG_FEATURE_LS_SORTFILES=y
CONFIG_FEATURE_LS_TIMESTAMPS=y
CONFIG_MKDIR=y
CONFIG_RMDIR=y
CONFIG_RM=y
CONFIG_CP=y
CONFIG_MV=y
CONFIG_TOUCH=y
CONFIG_TRUE=y
CONFIG_FALSE=y
CONFIG_TEST=y
CONFIG_PRINTF=y
CONFIG_SLEEP=y
CONFIG_HEAD=y
CONFIG_TAIL=y
CONFIG_WC=y
CONFIG_SORT=y
CONFIG_UNIQ=y
CONFIG_CUT=y
CONFIG_TR=y
CONFIG_BASENAME=y
CONFIG_DIRNAME=y
CONFIG_SEQ=y
CONFIG_YES=y
CONFIG_ENV=y
CONFIG_UNAME=y
CONFIG_DATE=y
CONFIG_CLEAR=y
CONFIG_DD=y
CONFIG_SYNC=y
CONFIG_MKTEMP=y
CONFIG_WHICH=y

# ---- process tools --------------------------------------------------
CONFIG_PS=y
CONFIG_KILL=y
CONFIG_SLEEP=y

# ---- text ------------------------------------------------------------
CONFIG_GREP=y
CONFIG_EGREP=y
CONFIG_FGREP=y
CONFIG_SED=y
CONFIG_FIND=y
CONFIG_XARGS=y

# ---- explicitly OFF: needs Linux kernel headers or /proc ------------
CONFIG_OPENVT=n
CONFIG_KBD_MODE=n
CONFIG_LOADFONT=n
CONFIG_SETCONSOLE=n
CONFIG_DUMPKMAP=n
CONFIG_LOADKMAP=n
CONFIG_RESET=n
CONFIG_MOUNT=n
CONFIG_UMOUNT=n
CONFIG_SWAPON=n
CONFIG_SWAPOFF=n
CONFIG_MDEV=n
CONFIG_INIT=n
CONFIG_HALT=n
CONFIG_REBOOT=n
CONFIG_POWEROFF=n
CONFIG_TOP=n
CONFIG_FREE=n
CONFIG_DMESG=n
CONFIG_FSCK=n
CONFIG_LSATTR=n
CONFIG_CHATTR=n
CONFIG_MODPROBE=n
CONFIG_INSMOD=n
CONFIG_RMMOD=n
CONFIG_LSMOD=n
CONFIG_DEPMOD=n
CONFIG_RESUME=n
CONFIG_NSENTER=n
CONFIG_UNSHARE=n
CONFIG_SETPRIV=n
